{
    "name": "kicc/national-exhibition",
    "type": "project",
    "description": "KICC National Exhibition Platform — Full-Stack Laravel Application",
    "version": "1.0.0",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.8",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.29",
        "laravel/cashier": "^15.0",
        "laravel/tinker": "^3.0",
        "filament/filament": "^5.7",
        "spatie/laravel-permission": "^8.3",
        "africastalking/africastalking": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.35"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.18",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php -r \"is_dir('bootstrap/cache') || mkdir('bootstrap/cache', 0755, true); is_dir('storage/framework/cache') || mkdir('storage/framework/cache', 0755, true); is_dir('storage/framework/sessions') || mkdir('storage/framework/sessions', 0755, true); is_dir('storage/framework/views') || mkdir('storage/framework/views', 0755, true); is_dir('storage/logs') || mkdir('storage/logs', 0755, true);\"",
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
