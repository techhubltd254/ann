# KICC County Server configuration — {{COUNTY_NAME}} ({{COUNTY_SLUG}})
# Edit before first boot, then keep this file safe.

COUNTY_SLUG={{COUNTY_SLUG}}
PORT=8091
DATA_DIR=./data

# Seed accounts created on first boot:
#   county@kicc.go.ke    (COUNTY tier, scoped to {{COUNTY_SLUG}}) — password: KICC_SEED_COUNTY_PASSWORD
#   exhibitor@kicc.go.ke (EXHIBITOR tier)                          — password: exhibitor@2026
# CHANGE these after first login.
KICC_SEED_COUNTY_PASSWORD=county@2026

# OTA updates (signed manifest on kicctest.org; verified ed25519 + SHA-256 before swap)
KICC_UPDATE_ENABLED=true
KICC_UPDATE_MANIFEST_URL=https://kicctest.org/api/updates/manifest
KICC_UPDATE_CHANNEL=county
KICC_OTA_PUBLIC_KEY={{OTA_PUBLIC_KEY}}
KICC_HOME=.
KICC_UPDATE_RESTART_COMMAND="./server/ota-restart.sh . 8091"

# Nightly off-host backup → mother engine ingest (guarded by shared key)
BACKUP_SINK_URL=https://kicctest.org/api/engine/ops/backups/ingest
BACKUP_SINK_KEY={{BACKUP_SINK_KEY}}
BACKUP_SINK_SOURCE=county-{{COUNTY_SLUG}}

# CORS: the console is served by the engine itself; lock this down if fronted differently
KICC_CORS_ORIGINS=http://localhost:8091
