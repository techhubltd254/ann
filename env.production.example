# =============================================================================
# KICC LIVE PLATFORM — PRODUCTION ENVIRONMENT TEMPLATE
# =============================================================================
# Copy to .env on the production node and fill values. DO NOT commit.
# ALL values must come from environment/secrets — never hardcode.
# =============================================================================

# --- App core ---
APP_NAME=KICC
APP_ENV=production
APP_KEY=<GENERATE: php artisan key:generate>
APP_DEBUG=false
APP_URL=https://kicctest.org
ASSET_URL=https://kicctest.org

# --- Security (REQUIRED) ---
# Secret used to sign stream playback URLs — generate a long random string
SIGNED_URL_SECRET=<GENERATE: openssl rand -base64 32>
# Comma-separated IPs/CIDRs allowed to access /kicc-live/admin (Super Admin)
ADMIN_IP_WHITELIST=197.248.0.0/16,197.232.0.0/16
# Force HTTPS on sessions/cookies
SESSION_SECURE_COOKIE=true
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# --- Database (TiDB) ---
DB_CONNECTION=tidb
DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=kicc
DB_USERNAME=<YOUR_DB_USER>
DB_PASSWORD=<YOUR_DB_PASS>
DB_SSLMODE=verify-ca

# --- Redis (heartbeat broker state, sessions, rate-limit) ---
REDIS_CLIENT=phpredis
REDIS_HOST=<REDIS_HOST>
REDIS_PASSWORD=<REDIS_PASSWORD>
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# --- Queue (durable, for transcode + async writes) ---
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Cloudflare Stream (livestream ingest + playback) ---
CLOUDFLARE_ACCOUNT_ID=<YOUR_CF_ACCOUNT_ID>
CLOUDFLARE_API_TOKEN=<YOUR_CF_API_TOKEN>

# --- Media CDN (R2) ---
MEDIA_CDN_URL=https://kicc-r2-media.techhubltd254.workers.dev/storage
FILESYSTEM_DISK=r2
AWS_ACCESS_KEY_ID=<R2_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<R2_SECRET_KEY>
AWS_DEFAULT_REGION=auto
AWS_BUCKET=kicc-r2-media
AWS_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# --- Africa's Talking (SMS for OTP + alerts) ---
AFRICAS_TALKING_API_KEY=<AT_API_KEY>
AFRICAS_TALKING_USERNAME=sandbox

# --- N8n automation (heartbeat alerts, schedules, bookings) ---
N8N_BASE_URL=<YOUR_N8N_URL>
N8N_WEBHOOK_HEARTBEAT_ALERT=/webhook/kicc-heartbeat-alert
N8N_WEBHOOK_MEETING_BOOKED=/webhook/kicc-meeting-booked
N8N_WEBHOOK_SCHEDULE_AUTH=/webhook/kicc-schedule-auth

# --- M-Pesa (meeting booking / premium) ---
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=<MPESA_KEY>
MPESA_CONSUMER_SECRET=<MPESA_SECRET>
MPESA_PASSKEY=<MPESA_PASSKEY>
MPESA_SHORTCODE=<MPESA_SHORTCODE>

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=<SMTP_HOST>
MAIL_PORT=587
MAIL_USERNAME=<SMTP_USER>
MAIL_PASSWORD=<SMTP_PASS>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@kicctest.org
MAIL_FROM_NAME="${APP_NAME}"

# --- Monitoring ---
SENTRY_DSN=<OPTIONAL>
PULSE_ENABLED=true

# --- Security scan / audit cadence (see storage/logs/security-audit.log) ---
AUDIT_ENABLED=true