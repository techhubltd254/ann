APP_NAME=KICC-National-Exhibition
APP_ENV=local
# NEVER put a real key here — regenerate per environment with `php artisan key:generate`.
# This dev placeholder is only for CI/test runs and is NOT used in production.
APP_KEY=base64:/+wVChXbhm/1dd3k8oRM53ETT7tllG+D87y3XnSUCn4=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Database: TiDB Cloud (MySQL-compatible) ──
DB_CONNECTION=mysql
DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=kicc
DB_USERNAME=28dbcDfwh5hEbSc.root
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
DB_SSL_VERIFY=true

# ── Storage & CDN ──
FILESYSTEM_DISK=local
MEDIA_CDN_URL=https://kicc-proxy.techhubltd254.workers.dev/storage

# ── Redis Cache ──
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ── Session security (set SESSION_SECURE_COOKIE=true behind TLS) ──
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_SAME_SITE=lax

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CLIENT=phpredis
REDIS_DB=0
REDIS_CACHE_DB=1

# ── Cloudflare ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=

# ── Cloudflare R2 (Media Storage) ──
CLOUDFLARE_R2_BUCKET=kicc-media
CLOUDFLARE_R2_ENDPOINT=https://c8416e05ed0a3554806be51aac862ec4.r2.cloudflarestorage.com

# ── Mail ──
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@kicc.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS (for S3-compatible R2) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# ── Africa's Talking SMS / USSD ──
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=KICC
AFRICASTALKING_USSD_CODE=
AFRICASTALKING_USSD_CALLBACK_TOKEN=

# ── Elasticsearch (keyword search fallback; leave empty to use MySQL) ──
ELASTICSEARCH_HOST=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_SSL_VERIFY=false

VITE_APP_NAME="${APP_NAME}"
