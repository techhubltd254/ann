APP_NAME="KICC Experience Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR_DOMAIN

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=YOUR_TIDB_HOST
DB_PORT=4000
DB_DATABASE=kicc_experience
DB_USERNAME=YOUR_TIDB_SQL_USERNAME
DB_PASSWORD="YOUR_TIDB_SQL_PASSWORD"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SQLite is the reproducible local default. For a NEW TiDB database use:
# DB_CONNECTION=mysql
# DB_HOST=your-tidb-host
# DB_PORT=4000
DB_DATABASE=kicc_experience
# DB_USERNAME=your-new-database-user
DB_PASSWORD="YOUR_TIDB_SQL_PASSWORD"your-secret
# MYSQL_ATTR_SSL_CA=/absolute/path/to/ca.pem
# Never point fresh migrations at the original live database.
KICC_MEDIA_DISK=local
KICC_MAX_UPLOAD_KB=204800
# For a private Cloudflare R2 bucket set KICC_MEDIA_DISK=r2 and the fields below:
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Set ingress proxy ranges only when deployed behind a known load balancer.
TRUSTED_PROXIES=

MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true
