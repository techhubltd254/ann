APP_NAME=KICC-National-Exhibition
APP_ENV=local
# NEVER put a real key here — regenerate per environment with `php artisan key:generate`.
# This dev placeholder is only for CI/test runs and is NOT used in production.
APP_KEY=base64:/+wVChXbhm/1dd3k8oRM53ETT7tllG+D87y3XnSUCn4=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Database: TiDB Cloud (MySQL-compatible) ──
# Use the tidb connection (default). The mysql/mariadb connections also fall
# back to these TIDB_* vars, so even a platform-injected DB_CONNECTION=mysql
# cannot redirect the app away from TiDB.
DB_CONNECTION=tidb
TIDB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_DATABASE=kicc
TIDB_USERNAME=28dbcDfwh5hEbSc.root
TIDB_PASSWORD=
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
DB_SSL_VERIFY=false

# ── Storage & CDN ──
FILESYSTEM_DISK=local
MEDIA_CDN_URL=https://kicc-proxy.techhubltd254.workers.dev/storage

# ── Redis Cache ──
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ── Session security (set SESSION_SECURE_COOKIE=true behind TLS) ──
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_SAME_SITE=lax

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CLIENT=phpredis
REDIS_DB=0
REDIS_CACHE_DB=1

# ── Cloudflare ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=

# ── Cloudflare R2 (Media Storage) ──
CLOUDFLARE_R2_BUCKET=kicc-media
CLOUDFLARE_R2_ENDPOINT=https://c8416e05ed0a3554806be51aac862ec4.r2.cloudflarestorage.com

# ── Mail ──
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@kicc.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS (for S3-compatible R2) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# ── Africa's Talking SMS / USSD ──
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_FROM=KICC
AFRICASTALKING_USSD_CODE=
AFRICASTALKING_USSD_CALLBACK_TOKEN=

# ── Elasticsearch (keyword search fallback; leave empty to use MySQL) ──
ELASTICSEARCH_HOST=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_SSL_VERIFY=false

# ── Sentry Error Tracking (set a real DSN from sentry.io) ──
SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
SENTRY_SAMPLE_RATE=1.0

# ── Government API Integrations (leave empty to use document-upload fallback) ──
KRA_API_URL=https://api.kra.go.ke/v1
KRA_API_KEY=
HUDUMA_API_URL=https://api.huduma.go.ke/v1
HUDUMA_API_KEY=
NTSA_API_URL=
NTSA_API_KEY=
KWS_API_URL=
KWS_API_KEY=
EDUCATION_API_URL=
EDUCATION_API_KEY=
TOURISM_API_URL=
TOURISM_API_KEY=
AGRICULTURE_API_URL=
AGRICULTURE_API_KEY=
HEALTH_API_URL=
HEALTH_API_KEY=
MUSEUMS_API_URL=
MUSEUMS_API_KEY=

VITE_APP_NAME="${APP_NAME}"

# ── AI Video Pipeline (Kling / Wan replace Hailuo) ──
KLING_API_KEY=
KLING_BASE_URL=https://api.klingai.com/v1
WAN_API_KEY=
WAN_BASE_URL=https://api.wan.video/v1
HAILUO_API_KEY=
HAILUO_GROUP_ID=
TRIPO3D_API_KEY=

# ── KICC Algorithms service (Python, port 8400) ──
KICC_ALGORITHMS_URL=http://127.0.0.1:8400

# ── KICC Integration Layer (Node.js, port 8787 — payments/freight/customs/FX/webhooks) ──
KICC_INTEGRATION_URL=http://127.0.0.1:8787
KICC_INTEGRATION_WEBHOOK_SECRET=dev-secret
KICC_INTEGRATION_TIMEOUT=10
KICC_INTEGRATION_MAX_ATTEMPTS=3
KICC_INTEGRATION_BASE_DELAY_MS=200
KICC_INTEGRATION_MAX_DELAY_MS=5000

# ── KICC Inter-pipeline automation bus (Node.js, port 8790) ──
KICC_PIPELINE_BUS_URL=http://127.0.0.1:8790
KICC_PIPELINE_BUS_TIMEOUT=10
KICC_PIPELINE_BUS_MAX_ATTEMPTS=3
KICC_PIPELINE_BUS_BASE_DELAY_MS=200
KICC_PIPELINE_BUS_MAX_DELAY_MS=5000

# ── Deploy (export on the droplet — never commit secret values) ──
# GITHUB_DEPLOY_TOKEN=
# CF_TOKEN=
# CF_ACCOUNT=
# CLOUDFLARE_API_TOKEN=
