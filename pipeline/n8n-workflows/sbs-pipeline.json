{
  "name": "SBS 3D Pipeline",
  "nodes": [
    {
      "name": "Webhook: File Uploaded",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "parameters": {
        "path": "upload-video",
        "method": "POST",
        "options": {}
      }
    },
    {
      "name": "Analyze Scene (Kimi K3)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [450, 300],
      "parameters": {
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Authorization", "value": "Bearer {{$env.OPENROUTER_API_KEY}}"},
            {"name": "Content-Type", "value": "application/json"}
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "model", "value": "moonshotai/kimi-k3-mini"},
            {"name": "messages", "value": "[{\"role\": \"system\", \"content\": \"You are a 3D scene analysis expert. Return JSON with scene_type, depth_strength, convergence, pipeline, keyframe_indices.\"}, {\"role\": \"user\", \"content\": \"Analyze this exhibition video for 3D conversion.\"}]"},
            {"name": "temperature", "value": 0.1}
          ]
        }
      }
    },
    {
      "name": "Switch: Scene Type",
      "type": "n8n-nodes-base.switch",
      "position": [650, 300],
      "parameters": {
        "dataType": "string",
        "value1": "={{$json.scene_type}}",
        "rules": [
          {"value": "exhibition_hall", "output": 0},
          {"value": "booth_closeup", "output": 1},
          {"value": "walkthrough", "output": 2}
        ],
        "fallbackOutput": 1
      }
    },
    {
      "name": "Queue Depth Estimation",
      "type": "n8n-nodes-base.redis",
      "position": [850, 200],
      "parameters": {
        "operation": "publish",
        "channel": "pipeline:depth",
        "message": "={{JSON.stringify($json)}}"
      }
    },
    {
      "name": "Queue Splatting + SBS",
      "type": "n8n-nodes-base.redis",
      "position": [850, 450],
      "parameters": {
        "operation": "publish",
        "channel": "pipeline:hybrid",
        "message": "={{JSON.stringify($json)}}"
      }
    },
    {
      "name": "Upload to S3",
      "type": "n8n-nodes-base.s3",
      "position": [1050, 300],
      "parameters": {
        "operation": "upload",
        "bucket": "kenya-3d-output",
        "fileName": "={{$json.filename}}",
        "options": {}
      }
    },
    {
      "name": "Send Email Notification",
      "type": "n8n-nodes-base.emailSend",
      "position": [1250, 300],
      "parameters": {
        "fromEmail": "pipeline@kenya-exhibition.go.ke",
        "toEmail": "={{$json.user_email}}",
        "subject": "Your 3D Video is Ready",
        "text": "Your 3D video has been processed and is available at: {{$json.download_url}}"
      }
    }
  ],
  "connections": {
    "Webhook: File Uploaded": {"main": [[{"node": "Analyze Scene (Kimi K3)", "type": "main", "index": 0}]]},
    "Analyze Scene (Kimi K3)": {"main": [[{"node": "Switch: Scene Type", "type": "main", "index": 0}]]},
    "Switch: Scene Type": {
      "main": [
        [{"node": "Queue Depth Estimation", "type": "main", "index": 0}],
        [{"node": "Queue Depth Estimation", "type": "main", "index": 0}],
        [{"node": "Queue Splatting + SBS", "type": "main", "index": 0}]
      ]
    },
    "Queue Depth Estimation": {"main": [[{"node": "Upload to S3", "type": "main", "index": 0}]]},
    "Queue Splatting + SBS": {"main": [[{"node": "Upload to S3", "type": "main", "index": 0}]]},
    "Upload to S3": {"main": [[{"node": "Send Email Notification", "type": "main", "index": 0}]]}
  }
}
