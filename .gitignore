# integration service runtime env (secrets) + pid files
integrations-service/.env
.env.integration
*.pid
integrations-service/run/artifacts/

# pipeline bus registry (generated from pipeline_registrations on deploy)
pipelines.json
integration-map.json

# integration service runtime offsets (per-group consumer state)
integrations-service/run/offsets/

# deliverable/patche archives kept out of git history
*.zip

# archived directories and root assets (keep out of git, live on filesystem)
_archive/

# root-level binary/document files (not source code)
*.pdf
*.xlsx
*.pptx
*.docx
*.csv
*.mp4
!infra/**/*.pdf
ARCHITECTURE.*
WORKFLOW_TREES.*
